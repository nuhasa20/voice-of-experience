# ==============================================================================
# Voice of Experience (صوت الخبرة) — Environment Configuration Template
# Copy this file to .env and insert your API keys:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# API Keys (Required for transcription and extraction)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------------------------------------------
# Speech-to-Text Model Configuration
# Fallback order: STT_PRIMARY_MODEL -> STT_SECONDARY_MODEL -> STT_TERTIARY_MODEL
# ------------------------------------------------------------------------------
STT_PRIMARY_MODEL=gemini-3.8-flash
STT_SECONDARY_MODEL=gemini-3.5-flash
STT_TERTIARY_MODEL=whisper-large-v3

# ------------------------------------------------------------------------------
# Diagnostic Field Extraction Models
# ------------------------------------------------------------------------------
EXTRACTION_MODEL=gemini-3.1-flash-lite
EXTRACTION_FALLBACK_MODEL=gemini-3.6-flash

# ------------------------------------------------------------------------------
# Search Retrieval Threshold (Calibrated for character n-gram cosine similarity)
# Scores below this threshold trigger the honest "I don't know" fallback panel.
# ------------------------------------------------------------------------------
SEARCH_THRESHOLD=0.19
